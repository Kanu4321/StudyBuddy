# ==========================================
# StudyBuddy - Root .gitignore
# ==========================================

# Virtual Environments (Python)
.venv/
.venv*/
venv/
venv*/
ENV/
env/
backend/.venv/
backend/venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
.coverage.*
.cache/
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
pytestdebug.log
pip-log.txt
pip-delete-this-directory.txt
.tox/
backend/**/__pycache__/
backend/app/**/__pycache__/

# Node.js & Frontend Dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.lerna-debug.log*

# Build Outputs
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
build/
*.local

# Environment & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Local Databases, Vector Stores & Test Artifacts
*.db
*.db-journal
*.sqlite
*.sqlite3
data/
backend/data/
backend/data/chroma/
backend/chroma_db_test/
chroma/

# IDE, OS & Editor Temp Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# TypeScript / Vite Caches
*.tsbuildinfo
.vite/
frontend/.vite/

# Logs
*.log
logs/
